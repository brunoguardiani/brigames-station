# Remote API runtime. Copy to .env.production on the VPS; never commit that file.
HTTP_ADDR=:8080
DATABASE_URL=postgresql://postgres.project-ref:replace-with-url-encoded-password@aws-region.pooler.supabase.com:5432/postgres?sslmode=require

# Authentication
AUTH_REGISTRATION_ENABLED=false
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_JWT_ISSUER=brigames-station
AUTH_JWT_AUDIENCE=brigames-station-desktop
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# LiveKit is configured in the next Phase 8 delivery.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=replace-before-starting-the-api
LIVEKIT_API_SECRET=replace-before-starting-the-api
LIVEKIT_TOKEN_TTL=15m

# Used only by the explicit seed-owner tool.
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
