{
  "name": "@brigames-station/desktop",
  "version": "1.0.11",
  "private": true,
  "description": "brigames-station desktop application.",
  "author": {
    "name": "Bruno Guardiani",
    "email": "brunodipaolo12@gmail.com"
  },
  "homepage": "https://github.com/brunoguardiani/brigames-station",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunoguardiani/brigames-station.git"
  },
  "desktopName": "brigames-station.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "ng build && tsc -p electron/tsconfig.json",
    "test:updater": "tsc -p electron/tsconfig.test.json && node --test out/updater-tests/updater/updater.service.test.js",
    "test:call-preview": "tsc -p tsconfig.call-preview-test.json && node --test out/call-preview-tests/tests/call-mini-preview-state.test.js",
    "test": "pnpm run test:updater && pnpm run test:call-preview",
    "serve": "ng serve --host 127.0.0.1 --port 4200",
    "electron": "tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "dist:win": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "prepare:mac-icon": "sh scripts/create-macos-icon.sh",
    "dist:mac": "pnpm run build && pnpm run prepare:mac-icon && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:linux": "pnpm run build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@livekit/throws-transformer": "0.1.8",
    "electron-updater": "6.8.9",
    "livekit-client": "2.21.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@types/node": "^26.2.0",
    "@types/sdp-transform": "^3.0.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.6",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.brigames-station.desktop",
    "productName": "brigames-station",
    "executableName": "brigames-station",
    "publish": [
      {
        "provider": "github",
        "owner": "brunoguardiani",
        "repo": "brigames-station"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/brigames-station-icon.png",
      "artifactName": "brigames-station-Setup-${version}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/brigames-station.icns",
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O brigames-station usa o microfone para canais de voz.",
        "NSCameraUsageDescription": "O brigames-station usa a câmera quando você decide compartilhá-la em um canal de voz."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/brigames-station-icon.png",
      "category": "Network;Chat;InstantMessaging",
      "maintainer": "Bruno Guardiani <brunodipaolo12@gmail.com>",
      "syncDesktopName": true,
      "artifactName": "brigames-station-${version}-${arch}.${ext}"
    }
  }
}
