{
  "name": "@brigames-station/desktop",
  "version": "1.2.1",
  "private": true,
  "description": "brigames-station desktop application.",
  "author": {
    "name": "Bruno Guardiani",
    "email": "brunodipaolo12@gmail.com"
  },
  "homepage": "https://github.com/brunoguardiani/brigames-station",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunoguardiani/brigames-station.git"
  },
  "desktopName": "brigames-station.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "node scripts/copy-dfn.mjs && ng build && tsc -p electron/tsconfig.json",
    "copy:dfn": "node scripts/copy-dfn.mjs",
    "test:updater": "tsc -p electron/tsconfig.test.json && node --test out/updater-tests/updater/*.test.js",
    "test:call-preview": "tsc -p tsconfig.call-preview-test.json && node --test out/call-preview-tests/tests/*.test.js",
    "test": "pnpm run test:updater && pnpm run test:call-preview",
    "serve": "ng serve --host 127.0.0.1 --port 4200",
    "electron": "node scripts/copy-dfn.mjs && tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "electron:second": "tsc -p electron/tsconfig.json && BRIGAMES_TEST_INSTANCE=1 electron dist-electron/main.js",
    "dist:win": "pnpm run build && electron-builder --config electron-builder.config.js --win nsis --x64 --publish never",
    "prepare:mac-icon": "sh scripts/create-macos-icon.sh",
    "dist:mac": "pnpm run build && pnpm run prepare:mac-icon && electron-builder --config electron-builder.config.js --mac dmg:x64 dmg:arm64 zip:universal --publish never && node scripts/cleanup-macos-update-metadata.cjs",
    "dist:linux": "pnpm run build && electron-builder --config electron-builder.config.js --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@livekit/throws-transformer": "0.1.8",
    "@lofcz/deepfilternet-web": "^0.1.0",
    "electron-sparkle-updater": "0.3.0",
    "electron-updater": "6.8.9",
    "livekit-client": "2.21.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@types/node": "^26.2.0",
    "@types/sdp-transform": "^3.0.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.6",
    "typescript": "^6.0.3"
  }
}
