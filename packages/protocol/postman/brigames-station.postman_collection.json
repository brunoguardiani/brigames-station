{
  "info": {
    "name": "brigames-station API",
    "description": "Manual checks for operational, identity, and Phase 2 server/channel endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" },
    { "key": "username", "value": "test_member" },
    { "key": "email", "value": "test-member@example.test" },
    { "key": "password", "value": "change-this-password" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "serverId", "value": "" },
    { "key": "serverName", "value": "My test server" },
    { "key": "channelName", "value": "planning" },
    { "key": "voiceChannelName", "value": "Sala de voz" },
    { "key": "channelId", "value": "" },
    { "key": "messageContent", "value": "Hello from Postman" },
    { "key": "inviteCode", "value": "" }
  ],
  "item": [
    {
      "name": "Operational",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('alive');"] } }]
        },
        {
          "name": "Ready",
          "request": { "method": "GET", "url": "{{baseUrl}}/ready" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('ready');"] } }]
        }
      ]
    },
    {
      "name": "Authentication (Phase 1)",
      "item": [
        {
          "name": "Register",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }, "url": "{{baseUrl}}/auth/register" }
        },
        {
          "name": "Login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"identity\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));", "const tokens = pm.response.json();", "pm.collectionVariables.set('accessToken', tokens.access_token);", "pm.collectionVariables.set('refreshToken', tokens.refresh_token);"] } }]
        },
        {
          "name": "Me",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/me" }
        },
        {
          "name": "Refresh",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" }, "url": "{{baseUrl}}/auth/refresh" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" }, "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Servers and Channels (Phase 2)",
      "item": [
        {
          "name": "Create Server",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{serverName}}\",\n  \"description\": \"Created from Postman\"\n}" }, "url": "{{baseUrl}}/servers" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('serverId', pm.response.json().id);"] } }]
        },
        {
          "name": "List Servers",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/servers" }
        },
        {
          "name": "List Server Members",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/servers/{{serverId}}/members" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"] } }]
        },
        {
          "name": "List Channels",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/servers/{{serverId}}/channels" }
        },
        {
          "name": "Create Channel",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{channelName}}\"\n}" }, "url": "{{baseUrl}}/servers/{{serverId}}/channels" }
        },
        {
          "name": "Create Voice Channel",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{voiceChannelName}}\",\n  \"type\": \"voice\"\n}" }, "url": "{{baseUrl}}/servers/{{serverId}}/channels" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('channelId', pm.response.json().id);"] } }]
        },
        {
          "name": "Leave Server",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/servers/{{serverId}}/leave" }
        }
      ]
    },
    {
      "name": "Messages (Phase 3)",
      "item": [
        { "name": "Create Message", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"{{messageContent}}\"\n}" }, "url": "{{baseUrl}}/channels/{{channelId}}/messages" } },
        { "name": "List Messages", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/channels/{{channelId}}/messages" } }
      ]
    },
    {
      "name": "Invites (Phase 4)",
      "item": [
        { "name": "Create Invite", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/servers/{{serverId}}/invites" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('inviteCode', pm.response.json().code);"] } }] },
        { "name": "Join Invite", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invites/{{inviteCode}}/join" } }
      ]
    },
    {
      "name": "Voice (Phase 6)",
      "item": [
        { "name": "Create Voice Token", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/voice/channels/{{channelId}}/token" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.url).to.be.a('string');", "pm.expect(body.token).to.be.a('string');", "pm.expect(body.room).to.be.a('string');"] } }] },
        { "name": "Set Voice Presence", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"channel_id\": {{channelId}}\n}" }, "url": "{{baseUrl}}/voice/presence" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 204', () => pm.response.to.have.status(204));"] } }] },
        { "name": "Clear Voice Presence", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"channel_id\": null\n}" }, "url": "{{baseUrl}}/voice/presence" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 204', () => pm.response.to.have.status(204));"] } }] }
      ]
    }
  ]
}
