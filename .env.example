# Go HTTP server
HTTP_ADDR=:8080
DESKTOP_BACKEND_URL=http://127.0.0.1:8080

# Local PostgreSQL container
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brigames_station
POSTGRES_USER=brigames
POSTGRES_PASSWORD=change-me

# Go backend connection string
DATABASE_URL=postgres://brigames:change-me@localhost:5432/brigames_station?sslmode=disable

# Authentication (local development values only; replace the JWT secret in .env)
AUTH_REGISTRATION_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# First owner bootstrap (required only by `go run ./cmd/seed-owner`)
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
